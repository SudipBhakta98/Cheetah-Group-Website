---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us">
  <section class="bg-slate-900 border-b border-slate-800 py-16 text-center">
    <h1 class="text-4xl font-extrabold text-white">ABOUT US</h1>
    <p class="text-slate-400 mt-2">Home &gt; About Us</p>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
      <div>
        <h2 class="text-2xl font-bold text-amber-500 mb-4">WHO WE ARE</h2>
        <p class="text-slate-300 leading-relaxed mb-4">
          Mechwork Solutions is a trusted name in mechanical piece work and manpower supply services. With years of expertise, we are committed to delivering high-quality work on time, every time.
        </p>
        <p class="text-slate-300 leading-relaxed">
          Our modern infrastructure, skilled team, and customer-first approach help us meet the diverse needs of clients across various industrial sectors.
        </p>
      </div>
      <div class="rounded-xl overflow-hidden border border-slate-800">
        <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=800&q=80" alt="Factory Overview" class="w-full h-80 object-cover" />
      </div>
    </div>

    <div class="grid md:grid-cols-4 gap-6">
      <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl text-center">
        <h3 class="text-amber-500 font-bold text-lg mb-2">OUR MISSION</h3>
        <p class="text-slate-400 text-sm">To provide quality services that add value to our business customers.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl text-center">
        <h3 class="text-amber-500 font-bold text-lg mb-2">OUR VISION</h3>
        <p class="text-slate-400 text-sm">To be a leading and trusted service provider across the industry.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl text-center">
        <h3 class="text-amber-500 font-bold text-lg mb-2">OUR VALUES</h3>
        <p class="text-slate-400 text-sm">Integrity, Quality, Commitment, and Teamwork in every endeavor.</p>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl text-center">
        <h3 class="text-amber-500 font-bold text-lg mb-2">QUALITY POLICY</h3>
        <p class="text-slate-400 text-sm">Dedicated to continuous improvement and total client satisfaction.</p>
      </div>
    </div>
  </section>
</Layout>