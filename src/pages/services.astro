---
import Layout from '../layouts/Layout.astro';

const mechanicalServices = [
  { title: "Powder Coating Piece Work", desc: "High-quality powder coating for long-lasting, corrosion-resistant finish.", items: ["Pre-treatment", "Powder Coating", "Curing", "Quality Inspection"] },
  { title: "Welding Piece Work", desc: "Expert in all types of welding processes ensuring strong, precise joints.", items: ["MIG Welding", "TIG Welding", "Spot Welding", "Arc Welding"] },
  { title: "Bending Piece Work", desc: "CNC and V-Bending services for MS, SS, Aluminum, and GI sheets.", items: ["CNC Bending", "Press Brake Bending", "Rolling", "Fabrication Support"] }
];

const hrServices = [
  { title: "Manpower Supply", desc: "We supply skilled, semi-skilled, and unskilled manpower for industrial operations.", items: ["Skilled Manpower", "Semi-skilled Manpower", "Unskilled Manpower", "Temporary Staffing"] },
  { title: "Security Staff Supply", desc: "Professional and well-trained security staff to ensure safety and peace of mind.", items: ["Security Guards", "Supervisors", "CCTV Monitoring", "24/7 Support"] }
];
---

<Layout title="Our Services">
  <section class="bg-slate-900 border-b border-slate-800 py-16 text-center">
    <h1 class="text-4xl font-extrabold text-white">OUR SERVICES</h1>
    <p class="text-slate-400 mt-2">Home &gt; Services</p>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-6">
    <h2 class="text-2xl font-bold text-amber-500 mb-8 border-b border-slate-800 pb-3">MECHANICAL PIECE WORK SERVICES</h2>
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      {mechanicalServices.map((service) => (
        <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl">
          <h3 class="text-xl font-bold text-white mb-2">{service.title}</h3>
          <p class="text-slate-400 text-sm mb-4">{service.desc}</p>
          <ul class="space-y-2 text-sm text-slate-300">
            {service.items.map((item) => <li class="flex items-center gap-2"><span class="text-amber-500">•</span> {item}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-amber-500 mb-8 border-b border-slate-800 pb-3">HUMAN RESOURCE MANAGEMENT SERVICES</h2>
    <div class="grid md:grid-cols-2 gap-8">
      {hrServices.map((service) => (
        <div class="bg-slate-900 border border-slate-800 p-6 rounded-xl">
          <h3 class="text-xl font-bold text-white mb-2">{service.title}</h3>
          <p class="text-slate-400 text-sm mb-4">{service.desc}</p>
          <ul class="space-y-2 text-sm text-slate-300">
            {service.items.map((item) => <li class="flex items-center gap-2"><span class="text-amber-500">•</span> {item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>