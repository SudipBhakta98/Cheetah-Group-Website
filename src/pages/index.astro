---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="relative bg-slate-900 border-b border-slate-800 py-12 sm:py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div class="text-center lg:text-left">
        <p class="text-amber-500 font-semibold tracking-wider text-xs sm:text-sm mb-2 sm:mb-3">PRECISION WORK. TRUSTED PEOPLE.</p>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white leading-tight mb-4 sm:mb-6">
          MECHANICAL PIECE WORK & HUMAN RESOURCE SOLUTIONS
        </h1>
        <p class="text-slate-300 text-sm sm:text-lg mb-6 sm:mb-8 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Delivering high-quality mechanical piece work and reliable manpower & security solutions to power your business forward.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
          <a href="/services" class="w-full sm:w-auto bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-6 py-3 rounded text-center transition-all">Our Services</a>
          <a href="/contact" class="w-full sm:w-auto border border-slate-700 hover:border-amber-500 text-white font-semibold px-6 py-3 rounded text-center transition-all">Talk to Expert →</a>
        </div>
      </div>
      <div class="rounded-xl sm:rounded-2xl overflow-hidden border border-slate-800 shadow-2xl mt-6 lg:mt-0">
        <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=1000&q=80" alt="Industrial Welding Work" class="w-full h-64 sm:h-96 lg:h-[450px] object-cover" />
      </div>
    </div>
  </section>

  <!-- Responsive Stats Bar -->
  <section class="bg-slate-950 border-b border-slate-800 py-8 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 text-center">
      <div class="p-2">
        <div class="text-2xl sm:text-4xl font-extrabold text-amber-500">10+</div>
        <div class="text-xs sm:text-sm text-slate-400 mt-1">Years Experience</div>
      </div>
      <div class="p-2">
        <div class="text-2xl sm:text-4xl font-extrabold text-amber-500">500+</div>
        <div class="text-xs sm:text-sm text-slate-400 mt-1">Happy Clients</div>
      </div>
      <div class="p-2">
        <div class="text-2xl sm:text-4xl font-extrabold text-amber-500">1000+</div>
        <div class="text-xs sm:text-sm text-slate-400 mt-1">Projects Completed</div>
      </div>
      <div class="p-2">
        <div class="text-2xl sm:text-4xl font-extrabold text-amber-500">50+</div>
        <div class="text-xs sm:text-sm text-slate-400 mt-1">Skilled Employees</div>
      </div>
    </div>
  </section>

  <!-- Main Categories -->
  <section class="py-12 sm:py-20 bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-center text-white mb-8 sm:mb-12">OUR MAIN CATEGORIES</h2>
      <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
        <div class="bg-slate-950 border border-slate-800 p-6 sm:p-8 rounded-xl flex flex-col justify-between">
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-amber-500 mb-3">MECHANICAL PIECE WORK</h3>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">Precision engineering services with advanced technology and skilled professionals.</p>
          </div>
          <a href="/services" class="text-amber-500 font-semibold hover:underline text-sm sm:text-base">Explore Services →</a>
        </div>
        <div class="bg-slate-950 border border-slate-800 p-6 sm:p-8 rounded-xl flex flex-col justify-between">
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-amber-500 mb-3">HUMAN RESOURCE MANAGEMENT</h3>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">Manpower supply and security staff solutions tailored to your business requirements.</p>
          </div>
          <a href="/services" class="text-amber-500 font-semibold hover:underline text-sm sm:text-base">Explore Services →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>