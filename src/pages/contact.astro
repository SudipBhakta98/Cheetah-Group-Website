---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us">
  <section class="bg-slate-900 border-b border-slate-800 py-10 sm:py-16 text-center">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white">CONTACT US</h1>
    <p class="text-slate-400 text-sm sm:text-base mt-2">Home &gt; Contact Us</p>
  </section>

  <section class="py-10 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-8 lg:gap-12">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-4 sm:mb-6">GET IN TOUCH</h2>
      <p class="text-slate-300 text-sm sm:text-base mb-6 sm:mb-8">We are here to help you. Reach out to us for any inquiries or quotations.</p>
      
      <div class="space-y-3 sm:space-y-4 text-slate-300 text-sm sm:text-base">
        <p><strong>Phone:</strong> +91 12345 67890 / +91 98765 43210</p>
        <p><strong>Email:</strong> info@mechworksolutions.com</p>
        <p><strong>Address:</strong> 123, Industrial Area, City, State - 000000</p>
        <p><strong>Working Hours:</strong> Mon - Sat: 9:00 AM - 6:00 PM (Sunday Closed)</p>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="bg-slate-900 border border-slate-800 p-6 sm:p-8 rounded-xl">
      <h3 class="text-lg sm:text-xl font-bold text-white mb-6">SEND US A MESSAGE</h3>
      
      <form id="contact-form" class="space-y-4">
        <div>
          <label for="name" class="block text-xs font-semibold uppercase text-slate-400 mb-1">Your Name</label>
          <input type="text" id="name" name="name" required class="w-full bg-slate-950 border border-slate-800 rounded p-3 text-white text-sm focus:outline-none focus:border-amber-500" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="email" class="block text-xs font-semibold uppercase text-slate-400 mb-1">Your Email</label>
            <input type="email" id="email" name="email" required class="w-full bg-slate-950 border border-slate-800 rounded p-3 text-white text-sm focus:outline-none focus:border-amber-500" />
          </div>
          <div>
            <label for="phone" class="block text-xs font-semibold uppercase text-slate-400 mb-1">Your Phone</label>
            <input type="text" id="phone" name="phone" class="w-full bg-slate-950 border border-slate-800 rounded p-3 text-white text-sm focus:outline-none focus:border-amber-500" />
          </div>
        </div>
        <div>
          <label for="subject" class="block text-xs font-semibold uppercase text-slate-400 mb-1">Subject</label>
          <input type="text" id="subject" name="subject" class="w-full bg-slate-950 border border-slate-800 rounded p-3 text-white text-sm focus:outline-none focus:border-amber-500" />
        </div>
        <div>
          <label for="message" class="block text-xs font-semibold uppercase text-slate-400 mb-1">Your Message</label>
          <textarea id="message" name="message" rows="4" required class="w-full bg-slate-950 border border-slate-800 rounded p-3 text-white text-sm focus:outline-none focus:border-amber-500"></textarea>
        </div>
        
        <button type="submit" id="submit-btn" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3 rounded text-sm sm:text-base transition-all">
          Send Message
        </button>
        <p id="form-status" class="text-sm font-medium mt-2 text-center"></p>
      </form>
    </div>
  </section>
</Layout>